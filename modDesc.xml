  <title>
    <de>Tierarzt &amp; Tierkrankheiten</de>
    <en>Veterinarian &amp; Animal Diseases</en>
  </title>
  <description>
    <de>Tiere können zufällig erkranken. Rufe in der Nähe eines eigenen Stalls den Tierarzt, um kranke Tiere behandeln zu lassen.</de>
    <en>Animals may become ill. Call the veterinarian near one of your husbandries to treat sick animals.</en>
  </description>
  <iconFilename>icon_Veterinarian.dds</iconFilename>
  <multiplayer supported="true" />
  <actions>
    <action name="VET_INSEMINATE" axisType="HALF" />
  </actions>
  <inputBinding>
    <actionBinding action="VET_INSEMINATE">
      <binding device="KB_MOUSE_DEFAULT" input="KEY_i" axisComponent="+" neutralInput="0" index="1" />
    </actionBinding>
  </inputBinding>
  <extraSourceFiles>
